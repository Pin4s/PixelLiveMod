# Copy this file to .env in the project root and fill in the public LIVE username.
TIKTOK_USERNAME=
# Optional: paste your Euler Stream API key after the equals sign.
EULER_STREAM_API_KEY=
# Optional: numeric ID of the current LIVE room, if username lookup fails.
# TIKTOK_ROOM_ID=
# Match [Bridge] Port in BepInEx/config/com.pixellive.mod.cfg.
PIXELLIVEMOD_BRIDGE_PORT=19081
